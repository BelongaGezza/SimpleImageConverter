## Example Pattern
```rust
// Following the established pattern from Senior's reference:
impl ImageFormat for JpegHandler {
    fn read(&self, path: &Path) -> Result<Image, FormatError> {
        // Validate first
        self.validate_path(path)?;

        // Use image crate with proper error mapping
        let img = image::open(path)
            .map_err(|e| FormatError::ReadError(e.to_string()))?;

        Ok(Image::from_dynamic(img))
    }
}
```

