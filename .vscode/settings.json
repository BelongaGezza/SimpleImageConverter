{
  // Rust Analyzer settings
  // Note: checkOnSave uses separate property format (not an object)
  // If you see "expected a boolean" errors, check user-level settings for conflicts
  "rust-analyzer.checkOnSave.enable": true,
  "rust-analyzer.checkOnSave.command": "clippy",
  "rust-analyzer.checkOnSave.allTargets": true,
  "rust-analyzer.cargo.allFeatures": true,
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.inlayHints.parameterHints.enable": true,
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.inlayHints.lifetimeElisionHints.enable": "skip_trivial",
  "rust-analyzer.completion.autoimport.enable": true,
  "rust-analyzer.imports.granularity.group": "module",
  "rust-analyzer.imports.prefix": "crate",
  
  // Workspace-specific settings for multi-crate project
  "rust-analyzer.linkedProjects": [
    "Cargo.toml"
  ],
  
  // Editor settings for Rust
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  
  // TOML file settings
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  
  // Files to exclude from search
  "files.exclude": {
    "**/target": true
  },
  
  // Search exclusions
  "search.exclude": {
    "**/target": true,
    "**/Cargo.lock": true
  }
}

